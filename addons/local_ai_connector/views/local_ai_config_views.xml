<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_local_ai_config_form" model="ir.ui.view">
        <field name="name">local.ai.config.form</field>
        <field name="model">local.ai.config</field>
        <field name="arch" type="xml">
            <form string="Local AI Configuration">
                <header>
                    <button name="action_test_connection" string="Test Connection &amp; Load Models" type="object" class="btn-primary" icon="fa-bolt"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuration Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Local Server Connection">
                            <field name="provider" widget="radio"/>
                            <field name="base_url" placeholder="http://host.docker.internal:1234/v1"/>
                            <field name="api_key" password="True"/>
                            <field name="timeout"/>
                        </group>
                        <group string="Model Mapping">
                            <field name="chat_model" placeholder="qwen3.5-4b-uncensored-hauhaucs-aggressive or deepseek-r1:14b"/>
                            <field name="sql_model" placeholder="qwen2.5-coder:14b or deepseek-coder"/>
                            <field name="ocr_model" placeholder="qwen2.5-vl"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Connection &amp; Detected Models" name="detected_models">
                            <group>
                                <field name="last_test_status" readonly="1"/>
                                <field name="available_models" readonly="1" widget="text"/>
                            </group>
                        </page>
                        <page string="Features &amp; Workflows" name="workflows_info">
                            <div class="alert alert-info" role="alert">
                                <h5><strong>Integrated 100% On-Premise AI Superpowers:</strong></h5>
                                <ul>
                                    <li><strong>Natural Language Business Intelligence (NL-to-SQL):</strong> Ask data questions in Discuss to generate read-only PostgreSQL queries with instant Markdown tables.</li>
                                    <li><strong>Smart Invoice OCR:</strong> Uses local vision models to extract line items from PDFs and receipts with zero external API calls.</li>
                                    <li><strong>Autonomous Helpdesk:</strong> Generates context-aware ticket resolutions against company records.</li>
                                    <li><strong>Complete Privacy:</strong> All tokens run on your local hardware (LM Studio or Ollama); zero external telemetry or cloud leakage.</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_local_ai_config_tree" model="ir.ui.view">
        <field name="name">local.ai.config.tree</field>
        <field name="model">local.ai.config</field>
        <field name="arch" type="xml">
            <list string="Local AI Configurations">
                <field name="name"/>
                <field name="provider"/>
                <field name="base_url"/>
                <field name="chat_model"/>
                <field name="last_test_status"/>
            </list>
        </field>
    </record>

    <record id="action_local_ai_config" model="ir.actions.act_window">
        <field name="name">Local AI Settings</field>
        <field name="res_model">local.ai.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your local LM Studio or Ollama connection!
            </p>
        </field>
    </record>

    <!-- Top-level and sub menus -->
    <menuitem id="menu_local_ai_root" name="Local AI" parent="base.menu_administration" sequence="100"/>
    <menuitem id="menu_local_ai_config" name="Providers &amp; Models" parent="menu_local_ai_root" action="action_local_ai_config" sequence="10"/>
</odoo>

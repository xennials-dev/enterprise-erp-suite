# ==============================================================================
# Environment Configuration - Blank Canvas Template
# Copy this file to .env and adjust variables as needed for your deployment.
# ==============================================================================

# Database Credentials
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=your_secure_password_here

# Local AI Endpoints (100% On-Premise, zero external cloud leakage)
# LM Studio runs by default on port 1234
LM_STUDIO_URL=http://host.docker.internal:1234/v1

# Ollama runs by default on port 11434
OLLAMA_URL=http://host.docker.internal:11434/v1

# Models
DEFAULT_CHAT_MODEL=qwen3.5-4b-uncensored-hauhaucs-aggressive
DEFAULT_SQL_MODEL=qwen2.5-coder:14b
DEFAULT_OCR_MODEL=qwen2.5-vl
